<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>Restling.Csv</PackageId>
    <Version>1.0.25.0</Version>
    <Authors>Alessandro Morvillo</Authors>
    <Description>Optional CSV content codec for Restling, powered by CsvHelper.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AMDevIT/Restling.git</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AMDevIT.Restling.Core\AMDevIT.Restling.Core.csproj" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
